# Copy to .env (never commit .env).
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pick a current Flash model id from AI Studio; "gemini-flash-latest" is the rolling alias.
GEMINI_MODEL=gemini-flash-latest
# Adzuna keys from https://developer.adzuna.com/ (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
PORT=8765
