APP_ORIGIN=http://localhost:8766

# Account verification (verification/): leave blank to keep it switched off.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
STRIPE_SECRET_KEY=
# Optional: set this to a writable, persistent database path on your host.
# VERIFICATION_DB=/path/to/persistent-storage/proofly.sqlite
# Store the demo signing key, issued-credential records and shared links in a persistent, private location.
# DEMO_CREDENTIAL_DB=/path/to/persistent-storage/demo-credentials.sqlite

# Trusted demo issuer key pair (Ed25519, base64url DER). Generate with: node scripts/generate-issuer-keys.mjs
# Set BOTH or NEITHER. With neither, the server generates a key once and keeps it in DEMO_CREDENTIAL_DB.
# The public key is what the server-side trusted issuer registry uses to verify credentials.
DEMO_ISSUER_PRIVATE_KEY=
DEMO_ISSUER_PUBLIC_KEY=

# Employer Lens AI. Groq is used when GROQ_API_KEY is set; otherwise Amazon Bedrock; otherwise offline.
# Groq key from https://console.groq.com/keys (free tier: ~8,000 tokens/min, about one lens run a minute).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Backup AI: Amazon Bedrock (Nova Lite). Use EITHER a Bedrock API key...
AWS_BEARER_TOKEN_BEDROCK=
# ...OR an IAM user's access keys with bedrock:InvokeModel permission.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# "us." is the cross-region inference profile Nova needs when called from us-east-1/us-west-2.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Calgary job picker: free keys from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
