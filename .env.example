APP_ORIGIN=http://localhost:8766
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
STRIPE_SECRET_KEY=
# Optional: set this to a writable, persistent database path on your host.
# VERIFICATION_DB=/path/to/persistent-storage/proofly.sqlite
AUTH0_DOMAIN=your-tenant.example.auth0.com
AUTH0_CLIENT_ID=replace-with-public-client-id
AUTH0_AUDIENCE=replace-with-api-identifier
STRIPE_SECRET_KEY=replace-locally-with-stripe-secret
# Employer Lens: Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a model your key can use (gemini-3.5-flash tested 2026-11-07; 2.5 is closed to new users).
GEMINI_MODEL=gemini-3.5-flash
# Calgary job picker: free keys from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
